# ── Base de datos ──
POSTGRES_DB=emcagua
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432

# ── Backend ──
BACKEND_PORT=8080
EMCAGUA_SECRETO=cambie-esta-clave-larga-de-desarrollo-emcagua-apc-2026
